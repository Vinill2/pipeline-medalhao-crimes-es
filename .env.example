# Copie este arquivo para .env (NUNCA commite o .env de verdade) e preencha.
# No GitHub Actions, isso vira um Secret chamado AZURE_STORAGE_CONNECTION_STRING,
# nao um arquivo .env (veja .github/workflows/pipeline.yml).
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=SEUACCOUNT;AccountKey=SUACHAVE;EndpointSuffix=core.windows.net
